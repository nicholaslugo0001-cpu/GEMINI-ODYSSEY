rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProgress(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64 &&
             data.googleCoins is int && data.googleCoins >= 0 &&
             data.totalCoinsCollected is int && data.totalCoinsCollected >= 0 &&
             data.level is int && data.level >= 1 &&
             data.xp is int && data.xp >= 0 &&
             data.skillPoints is int && data.skillPoints >= 0 &&
             data.attackStat is int && data.attackStat >= 1 &&
             data.defenseStat is int && data.defenseStat >= 1 &&
             data.staminaStat is int && data.staminaStat >= 1 &&
             data.healthStat is int && data.healthStat >= 1 &&
             data.tpuCoreLevel is int && data.tpuCoreLevel >= 1 && data.tpuCoreLevel <= 10 &&
             data.contextWindowLevel is int && data.contextWindowLevel >= 1 && data.contextWindowLevel <= 10 &&
             data.fiberOpticLevel is int && data.fiberOpticLevel >= 1 && data.fiberOpticLevel <= 10 &&
             data.neuralMagnetLevel is int && data.neuralMagnetLevel >= 1 && data.neuralMagnetLevel <= 10 &&
             data.sectorStars is map && data.sectorStars.size() <= 20 &&
             data.missionsCompleted is int && data.missionsCompleted >= 0 &&
             data.virusesPurged is int && data.virusesPurged >= 0 &&
             data.adwareBlocked is int && data.adwareBlocked >= 0 &&
             data.hackersOutsmarted is int && data.hackersOutsmarted >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64 &&
             data.level is int && data.level >= 1 &&
             data.totalStars is int && data.totalStars >= 0 && data.totalStars <= 20 &&
             data.totalCoinsCollected is int && data.totalCoinsCollected >= 0 &&
             data.missionsCompleted is int && data.missionsCompleted >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'googleCoins', 'totalCoinsCollected',
                         'level', 'xp', 'skillPoints', 'attackStat', 'defenseStat',
                         'staminaStat', 'healthStat', 'tpuCoreLevel', 'contextWindowLevel',
                         'fiberOpticLevel', 'neuralMagnetLevel', 'sectorStars',
                         'missionsCompleted', 'virusesPurged', 'adwareBlocked',
                         'hackersOutsmarted', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'googleCoins', 'totalCoinsCollected',
                         'level', 'xp', 'skillPoints', 'attackStat', 'defenseStat',
                         'staminaStat', 'healthStat', 'tpuCoreLevel', 'contextWindowLevel',
                         'fiberOpticLevel', 'neuralMagnetLevel', 'sectorStars',
                         'missionsCompleted', 'virusesPurged', 'adwareBlocked',
                         'hackersOutsmarted', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProgress(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProgress(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'googleCoins', 'totalCoinsCollected',
                         'level', 'xp', 'skillPoints', 'attackStat', 'defenseStat',
                         'staminaStat', 'healthStat', 'tpuCoreLevel', 'contextWindowLevel',
                         'fiberOpticLevel', 'neuralMagnetLevel', 'sectorStars',
                         'missionsCompleted', 'virusesPurged', 'adwareBlocked',
                         'hackersOutsmarted', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    match /leaderboard/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'level', 'totalStars',
                         'totalCoinsCollected', 'missionsCompleted', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'level', 'totalStars',
                         'totalCoinsCollected', 'missionsCompleted', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidLeaderboardEntry(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidLeaderboardEntry(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'level', 'totalStars',
                         'totalCoinsCollected', 'missionsCompleted', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    function isValidRoom(data, roomId) {
      return data.roomId is string && data.roomId == roomId && data.roomId.size() >= 4 && data.roomId.size() <= 16 &&
             data.roomCode is string && data.roomCode == roomId &&
             data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
             data.sectorId is string && data.sectorId.size() >= 1 && data.sectorId.size() <= 64 &&
             data.status in ['waiting', 'playing', 'finished'] &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 4 &&
             data.memberUids[0] is string &&
             data.wave is int && data.wave >= 1 && data.wave <= 20 &&
             data.nodesIndexed is int && data.nodesIndexed >= 0 && data.nodesIndexed <= 20 &&
             data.bossHp is number && data.bossHp >= 0 && data.bossHp <= 50000 &&
             data.bossMaxHp is number && data.bossMaxHp >= 0 && data.bossMaxHp <= 50000 &&
             data.enemySnapshots is list && data.enemySnapshots.size() <= 25 &&
             (data.enemySnapshots.size() == 0 || data.enemySnapshots[0] is map) &&
             data.isVictory is bool &&
             data.starsEarned is int && data.starsEarned >= 0 && data.starsEarned <= 5 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRoomPlayer(data, roomId, playerId) {
      return data.userId is string && data.userId == playerId && data.userId == request.auth.uid &&
             data.roomId is string && data.roomId == roomId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64 &&
             data.colorIndex is int && data.colorIndex >= 0 && data.colorIndex <= 3 &&
             data.ready is bool &&
             data.x is number && data.x >= -1000 && data.x <= 1000 &&
             data.y is number && data.y >= -1000 && data.y <= 1000 &&
             data.facingAngle is number && data.facingAngle >= -10 && data.facingAngle <= 10 &&
             data.hp is number && data.hp >= 0 && data.hp <= 5000 &&
             data.maxHp is number && data.maxHp >= 1 && data.maxHp <= 5000 &&
             data.isGuarding is bool &&
             data.isSlashing is bool &&
             data.slashComboStep is int && data.slashComboStep >= 0 && data.slashComboStep <= 2 &&
             data.walkPhase is number && data.walkPhase >= 0 && data.walkPhase <= 1000000 &&
             data.hitSeq is int && data.hitSeq >= 0 &&
             data.lastHitEnemyId is int && data.lastHitEnemyId >= -1 &&
             data.lastHitDamage is number && data.lastHitDamage >= 0 && data.lastHitDamage <= 5000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId) &&
                    (existing().status == 'waiting' || request.auth.uid in existing().memberUids);
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().keys().hasAll([
                         'roomId', 'roomCode', 'hostUid', 'sectorId', 'status',
                         'memberUids', 'wave', 'nodesIndexed', 'bossHp', 'bossMaxHp',
                         'enemySnapshots', 'isVictory', 'starsEarned', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'roomId', 'roomCode', 'hostUid', 'sectorId', 'status',
                         'memberUids', 'wave', 'nodesIndexed', 'bossHp', 'bossMaxHp',
                         'enemySnapshots', 'isVictory', 'starsEarned', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidRoom(incoming(), roomId) &&
                       incoming().hostUid == request.auth.uid &&
                       incoming().status == 'waiting' &&
                       incoming().memberUids.size() == 1 &&
                       incoming().memberUids[0] == request.auth.uid;

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       existing().status != 'finished' &&
                       isValidRoom(incoming(), roomId) &&
                       incoming().roomId == existing().roomId &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().hostUid == existing().hostUid &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Join waiting room (max 4 players)
                         (existing().status == 'waiting' &&
                          !(request.auth.uid in existing().memberUids) &&
                          existing().memberUids.size() < 4 &&
                          incoming().memberUids.hasAll(existing().memberUids) &&
                          request.auth.uid in incoming().memberUids &&
                          incoming().memberUids.size() == existing().memberUids.size() + 1 &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])) ||
                         // Action 2: Non-host leaves room
                         (request.auth.uid in existing().memberUids &&
                          request.auth.uid != existing().hostUid &&
                          !(request.auth.uid in incoming().memberUids) &&
                          incoming().memberUids.size() == existing().memberUids.size() - 1 &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])) ||
                         // Action 3: Host manages stage & broadcasts authoritative world state
                         (request.auth.uid == existing().hostUid &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'sectorId', 'status', 'wave', 'nodesIndexed', 'bossHp',
                            'bossMaxHp', 'enemySnapshots', 'isVictory', 'starsEarned', 'updatedAt'
                          ]))
                       );

      allow delete: if isSignedIn() && isValidId(roomId) && existing().hostUid == request.auth.uid;

      match /players/{playerId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(playerId) &&
                      (request.auth.uid == playerId ||
                       request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids);
        allow list: if isSignedIn() && request.auth.uid == resource.data.userId;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         incoming().keys().hasAll([
                           'userId', 'roomId', 'displayName', 'colorIndex', 'ready',
                           'x', 'y', 'facingAngle', 'hp', 'maxHp', 'isGuarding',
                           'isSlashing', 'slashComboStep', 'walkPhase', 'hitSeq',
                           'lastHitEnemyId', 'lastHitDamage', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'roomId', 'displayName', 'colorIndex', 'ready',
                           'x', 'y', 'facingAngle', 'hp', 'maxHp', 'isGuarding',
                           'isSlashing', 'slashComboStep', 'walkPhase', 'hitSeq',
                           'lastHitEnemyId', 'lastHitDamage', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidRoomPlayer(incoming(), roomId, playerId) &&
                         exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         isValidRoomPlayer(incoming(), roomId, playerId) &&
                         incoming().userId == existing().userId &&
                         incoming().roomId == existing().roomId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName', 'colorIndex', 'ready', 'x', 'y', 'facingAngle',
                           'hp', 'maxHp', 'isGuarding', 'isSlashing', 'slashComboStep',
                           'walkPhase', 'hitSeq', 'lastHitEnemyId', 'lastHitDamage', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(playerId) &&
                         (request.auth.uid == playerId ||
                          get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid);
      }
    }
  }
}
